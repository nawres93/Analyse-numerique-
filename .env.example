# === MongoDB ===
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=numerical_analysis_platform

# === JWT ===
# Génère une clé forte avec : python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=change_me_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Email (utilisé pour la vérification de compte et le reset password) ===
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Numerical Analysis Platform

# === Frontend (pour construire les liens dans les emails) ===
FRONTEND_URL=http://localhost:5173

# === CORS ===
CORS_ORIGINS=http://localhost:5173
